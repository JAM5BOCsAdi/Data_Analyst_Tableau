      <column caption='Quadrant_Color' datatype='string' name='[Calculation_1154891894809243661]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1154891894807846923] &gt;= [Parameters].[Parameter 3] AND AVG([Discount]) &gt;= [Parameters].[Parameter 2]&#13;&#10;    THEN &apos;Upper Right&apos;&#13;&#10;ELSEIF [Calculation_1154891894807846923] &gt;= [Parameters].[Parameter 3] AND AVG([Discount]) &lt; [Parameters].[Parameter 2]&#13;&#10;    THEN &apos;Upper Left&apos;&#13;&#10;ELSEIF [Calculation_1154891894807846923] &lt; [Parameters].[Parameter 3] AND AVG([Discount]) &gt;= [Parameters].[Parameter 2]&#13;&#10;    THEN &apos;Bottom Right&apos;&#13;&#10;ELSE &apos;Bottom Left&apos;&#13;&#10;END' />

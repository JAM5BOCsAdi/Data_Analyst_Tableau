      <column caption='Dynamic_Dimension' datatype='string' name='[Calculation_1277896452199047168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Country&apos; THEN [Country]&#13;&#10;WHEN &apos;Category&apos; THEN [Category]&#13;&#10;END' />
      </column>
      <column caption='Dynamic_Measure' datatype='real' name='[Calculation_1277896452200349697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &apos;Sales&apos; THEN [Sales]&#13;&#10;    WHEN &apos;Profit&apos; THEN [Profit]&#13;&#10;    WHEN &apos;Quantity&apos; THEN [Quantity]&#13;&#10;END' />
      </column>
      <column caption='KPI_Colors' datatype='string' name='[Calculation_149181794243325952]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; [Parameters].[Parameter 1] THEN &apos;Red&apos;&#13;&#10;ELSE &apos;Green&apos;&#13;&#10;END' />

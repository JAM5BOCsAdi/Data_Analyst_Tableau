      <column caption='Country_IF_ELSE' datatype='string' name='[Calculation_116530701493743616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Country] = &quot;Germany&quot; THEN &quot;DE&quot;&#13;&#10;ELSE &quot;N/A&quot;&#13;&#10;END' />
      </column>
      <column caption='Country_IIF' datatype='string' name='[Calculation_116530701494317057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Country]=&quot;Germany&quot;,&quot;DE&quot;,&quot;N/A&quot;)' />
      </column>
      <column caption='Country_CASE_WHEN' datatype='string' name='[Calculation_116530701495259139]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Country]&#13;&#10;    WHEN &quot;Germany&quot; THEN &quot;DE&quot;&#13;&#10;    WHEN &quot;France&quot; THEN &quot;FR&quot;&#13;&#10;    WHEN &quot;USA&quot; THEN &quot;US&quot;&#13;&#10;    ELSE &quot;N/A&quot;&#13;&#10;END' />
      </column>

      </column>
      <column caption='Phone_Replace1' datatype='string' name='[Calculation_1014998824726056972]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE([Phone],&quot;+&quot;,&quot;00&quot;)' />
      </column>
      <column caption='Phone_Replace2' datatype='string' name='[Calculation_1014998824726319117]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(REPLACE([Phone],&quot;+&quot;,&quot;00&quot;),&quot;-&quot;,&quot;&quot;)' />

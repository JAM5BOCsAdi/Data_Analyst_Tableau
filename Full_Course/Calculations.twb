      <column caption='01_Calc' datatype='string' name='[Calculation_97953349905027072]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Calculation comment&#13;&#10;IF SUM([Sales]) + 10 &gt; [Parameters].[Parameter 1] THEN &apos;High&apos;&#13;&#10;ELSE &apos;Low&apos;&#13;&#10;END' />
      </column>
      <column caption='Upper First Name' datatype='string' name='[Calculation_97953349905641475]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//Upper First Name&#13;&#10;UPPER([First_Name])' />
      </column>
      <column caption='Country (New)' datatype='integer' name='[Calculation_97953349934600196]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='LEN(LEFT(UPPER([Country]), 3))' />
      </column>
      <column caption='02_Calc' datatype='integer' name='[Calculation_97953349939601414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_97953349934600196] * 2' />
      </column>
      <column caption='Revenue' datatype='real' name='[Calculation_97953349947019271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Quantity] * [Unit_Price]' />
      </column>
      <column caption='Total Revenue by Category' datatype='real' name='[Calculation_97953349950365704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Category] : SUM([Calculation_97953349947019271])}' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_97953349951569929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_97953349947019271])' />
      </column>
      <column caption='Running Total Revenue' datatype='real' name='[Calculation_97953349952598026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_97953349947019271]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales_CEILING' datatype='integer' name='[Calculation_97953349973942284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CEILING([Sales])' />
      </column>
      <column caption='Sales_FLOOR' datatype='integer' name='[Calculation_97953349974163469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([Sales])' />
      </column>
      <column caption='Sales_ROUND' datatype='real' name='[Calculation_97953349974241294]' role='measure' type='quantitative'>
